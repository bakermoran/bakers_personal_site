{
  "name": "bakers-personal-site",
  "version": "0.0.1",
  "description": "A personal website for Baker Moran, built using Astro",
  "keywords": [
    "astro",
    "blog",
    "react"
  ],
  "license": "MIT",
  "author": "Baker Moran <baker.moran@gmail.com>",
  "repository": "https://github.com/bakermoran/bakers_personal_site",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "clean": "rimraf .cache public",
    "lint": "bun run lint:ts",
    "lint:commit": "commitlint --edit",
    "lint:staged": "lint-staged",
    "lint:ts": "oxlint src && prettier --check .",
    "prepare": "husky install",
    "semantic-release": "semantic-release",
    "test": "jest --config ./internal/testing/jest-config.ts",
    "test:coverage": "jest --coverage --config ./internal/testing/jest-config.ts",
    "test:update-snapshot": "jest --updateSnapshot --config ./internal/testing/jest-config.ts",
    "test:watch": "jest --watch --config ./internal/testing/jest-config.ts",
    "format": "oxfmt && prettier --write \"src/**/*.astro\"",
    "format:check": "oxfmt --check && prettier --check \"src/**/*.astro\""
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.2",
    "@astrojs/react": "^5.0.1",
    "@astrojs/rss": "^4.0.18",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@heroicons/react": "^2.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@tailwindcss/vite": "^4.2.2",
    "astro": "^6.0.8",
    "date-fns": "^4.1.0",
    "markdown-it": "^14.1.1",
    "mdast-util-to-string": "^4.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "reading-time": "^1.5.0",
    "sanitize-html": "^2.17.2",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.4.4",
    "@commitlint/config-conventional": "^17.4.4",
    "@semantic-release/exec": "6.0.3",
    "@semantic-release/git": "10.0.1",
    "@swc/core": "^1.3.38",
    "@swc/jest": "^0.2.24",
    "@testing-library/dom": "^8.20.0",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@types/jest": "^29.4.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-test-renderer": "^18.0.0",
    "@types/sass": "^1.43.1",
    "autoprefixer": "^10.4.13",
    "codecov": "^3.8.3",
    "conventional-changelog-conventionalcommits": "5.0.0",
    "husky": "8.0.3",
    "identity-obj-proxy": "3.0.0",
    "jest": "^29.5.0",
    "jest-cli": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0",
    "jest-svg-transformer": "^1.0.0",
    "oxfmt": "^0.41.0",
    "oxlint": "^0",
    "postcss": "^8.4.21",
    "prettier": "^2.8.4",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-packagejson": "^2.4.3",
    "semantic-release": "^20.1.1",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.1",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">=23.9.1"
  }
}
