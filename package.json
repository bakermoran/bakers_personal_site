{
  "name": "bakers-personal-site",
  "version": "0.0.2",
  "description": "A personal website for Baker Moran, built using Astro",
  "keywords": [
    "astro",
    "blog",
    "react"
  ],
  "license": "MIT",
  "author": "Baker Moran <baker.moran@gmail.com>",
  "repository": "https://github.com/bakermoran/bakers_personal_site",
  "scripts": {
    "dev": "astro dev",
    "dev:lan": "astro dev --host",
    "build": "astro build",
    "preview": "astro build && astro preview",
    "preview:lan": "astro build && astro preview --host",
    "astro": "astro",
    "typecheck": "astro check",
    "test": "vitest run",
    "lint": "oxlint",
    "format": "oxfmt && prettier --write \"src/**/*.astro\"",
    "format:check": "oxfmt --check && prettier --check \"src/**/*.astro\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/mdx": "5.0.4",
    "@astrojs/react": "5.0.4",
    "@astrojs/rss": "4.0.18",
    "@heroicons/react": "2.2.0",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-toast": "1.2.15",
    "@radix-ui/react-tooltip": "1.2.8",
    "@tailwindcss/vite": "4.2.2",
    "astro": "6.3.1",
    "date-fns": "4.1.0",
    "markdown-it": "14.1.1",
    "mdast-util-to-string": "4.0.0",
    "react": "19.2.4",
    "react-cmdk": "1.3.9",
    "react-dom": "19.2.4",
    "reading-time": "1.5.0",
    "sanitize-html": "2.17.2",
    "tailwind-merge": "3.5.0",
    "tailwindcss": "4.2.2",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@tailwindcss/typography": "0.5.19",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.12.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "husky": "9.1.7",
    "jsdom": "29.0.1",
    "oxfmt": "0.41.0",
    "oxlint": "0.18.1",
    "prettier": "3.8.1",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.7.2",
    "typescript": "6.0.2",
    "vitest": "4.1.2"
  },
  "engines": {
    "node": ">=23.9.1"
  }
}
