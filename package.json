{
  "name": "bakers-personal-site",
  "version": "0.0.2",
  "description": "A personal website for Baker Moran, built using Astro",
  "keywords": [
    "astro",
    "blog",
    "react"
  ],
  "license": "MIT",
  "author": "Baker Moran <baker.moran@gmail.com>",
  "repository": "https://github.com/bakermoran/bakers_personal_site",
  "scripts": {
    "dev": "astro dev",
    "dev:lan": "astro dev --host",
    "cms": "PORT=8082 decap-server",
    "build": "astro build",
    "preview": "astro build && astro preview",
    "preview:lan": "astro build && astro preview --host",
    "astro": "astro",
    "typecheck": "astro check",
    "test": "vitest run",
    "lint": "oxlint",
    "format": "oxfmt && prettier --write \"src/**/*.astro\"",
    "format:check": "oxfmt --check && prettier --check \"src/**/*.astro\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/mdx": "8.0.1",
    "@astrojs/react": "6.0.5",
    "@astrojs/rss": "4.0.19",
    "@heroicons/react": "2.2.0",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-toast": "1.2.23",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.2",
    "date-fns": "4.4.0",
    "markdown-it": "15.0.2",
    "mdast-util-to-string": "4.0.0",
    "react": "19.3.0",
    "react-cmdk": "1.3.9",
    "react-dom": "19.3.0",
    "reading-time": "1.5.0",
    "sanitize-html": "2.17.7",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@tailwindcss/typography": "0.5.20",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.0",
    "decap-server": "^3.11.2",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "1.0.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=23.9.1"
  }
}
