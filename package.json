{
  "name": "bakers-personal-site",
  "version": "0.0.1",
  "description": "A personal website for Baker Moran, built using Astro",
  "keywords": [
    "astro",
    "blog",
    "react"
  ],
  "license": "MIT",
  "author": "Baker Moran <baker.moran@gmail.com>",
  "repository": "https://github.com/bakermoran/bakers_personal_site",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "clean": "rimraf .cache public",
    "lint": "npm run lint:ts && npm run lint:scss",
    "lint:commit": "commitlint --edit",
    "lint:scss": "stylelint \"src/**/*.scss\"",
    "lint:staged": "lint-staged",
    "lint:ts": "oxlint src && prettier --check .",
    "prepare": "husky install",
    "semantic-release": "semantic-release",
    "test": "jest --config ./internal/testing/jest-config.ts",
    "test:coverage": "jest --coverage --config ./internal/testing/jest-config.ts",
    "test:update-snapshot": "jest --updateSnapshot --config ./internal/testing/jest-config.ts",
    "test:watch": "jest --watch --config ./internal/testing/jest-config.ts",
    "format": "oxfmt && prettier --write \"src/**/*.astro\"",
    "format:check": "oxfmt --check && prettier --check \"src/**/*.astro\""
  },
  "dependencies": {
    "@alxshelepenok/diesel": "^1.0.732",
    "@alxshelepenok/diesel-extensions": "^1.0.413",
    "@astrojs/mdx": "^5.0.2",
    "@astrojs/react": "^5.0.1",
    "@astrojs/rss": "^4.0.18",
    "@heroicons/react": "^2.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@sentry/tracing": "^7.40.0",
    "@tailwindcss/vite": "^4.2.2",
    "abab": "^2.0.6",
    "astro": "^6.0.8",
    "classnames": "^2.3.2",
    "date-fns": "^4.1.0",
    "disqus-react": "^1.1.5",
    "markdown-it": "^14.1.1",
    "mdast-util-to-string": "^4.0.0",
    "prismjs": "^1.29.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "reading-time": "^1.5.0",
    "sanitize-html": "^2.17.2",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.4.4",
    "@commitlint/config-conventional": "^17.4.4",
    "@jest/globals": "^29.5.0",
    "@semantic-release/exec": "6.0.3",
    "@semantic-release/git": "10.0.1",
    "@swc/core": "^1.3.38",
    "@swc/jest": "^0.2.24",
    "@testing-library/dom": "^8.20.0",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@types/jest": "^29.4.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-test-renderer": "^18.0.0",
    "@types/sass": "^1.43.1",
    "autoprefixer": "^10.4.13",
    "browserslist": "^4.21.5",
    "codecov": "^3.8.3",
    "concurrently": "^7.6.0",
    "conventional-changelog-conventionalcommits": "5.0.0",
    "husky": "8.0.3",
    "identity-obj-proxy": "3.0.0",
    "jest": "^29.5.0",
    "jest-cli": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0",
    "jest-svg-transformer": "^1.0.0",
    "lint-staged": "^13.1.2",
    "lost": "9.0.1",
    "oxfmt": "^0.41.0",
    "oxlint": "^0",
    "postcss": "^8.4.21",
    "postcss-scss": "^4.0.6",
    "prettier": "^2.8.4",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-packagejson": "^2.4.3",
    "react-test-renderer": "^18.2.0",
    "rimraf": "4.4.0",
    "sass": "^1.58.3",
    "semantic-release": "^20.1.1",
    "source-map-support": "^0.5.21",
    "stylelint": "^15.2.0",
    "stylelint-config-recommended-scss": "^9.0.1",
    "stylelint-order": "^6.0.3",
    "stylelint-scss": "^4.4.0",
    "ts-node": "^10.9.1",
    "typescript": "^4.9.5"
  },
  "lint-staged": {
    "*.{tsx?}": [
      "npm run format:ts"
    ],
    "*.{(sc|sa|c)ss}": [
      "npm run format:scss"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "engines": {
    "node": ">=23.9.1"
  }
}
