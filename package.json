{
  "name": "bakers-personal-site",
  "version": "0.0.2",
  "description": "A personal website for Baker Moran, built using Astro",
  "keywords": [
    "astro",
    "blog",
    "react"
  ],
  "license": "MIT",
  "author": "Baker Moran <baker.moran@gmail.com>",
  "repository": "https://github.com/bakermoran/bakers_personal_site",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "semantic-release": "semantic-release",
    "test": "vitest run",
    "lint": "oxlint",
    "format": "oxfmt && prettier --write \"src/**/*.astro\"",
    "format:check": "oxfmt --check && prettier --check \"src/**/*.astro\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/mdx": "5.0.3",
    "@astrojs/react": "5.0.3",
    "@astrojs/rss": "^4.0.18",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@heroicons/react": "^2.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.2.2",
    "astro": "6.1.5",
    "date-fns": "^4.1.0",
    "markdown-it": "^14.1.1",
    "mdast-util-to-string": "^4.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "reading-time": "^1.5.0",
    "sanitize-html": "^2.17.2",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@semantic-release/exec": "6.0.3",
    "@semantic-release/git": "10.0.1",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "oxfmt": "^0.41.0",
    "oxlint": "^0",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-packagejson": "^2.4.3",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "semantic-release": "^20.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=23.9.1"
  }
}
