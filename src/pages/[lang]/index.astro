---
import Divider from '@/components/Divider.astro';
import Hero from '@/components/Hero.astro';
import { ArrowRightIcon } from '@heroicons/react/24/outline'
import PostsList from '@/components/PostsList.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations } from '@/i18n/utils';
import { ui, type LangCodes } from '@/i18n/ui';
import Main from '@/layouts/Main.astro';

export function getStaticPaths() {
  return Object.keys(ui).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as LangCodes;
const t = useTranslations(lang);
---
<Main title={t("nav.home")} description={t("hero.subtitle")} class="flex flex-col gap-12">
  <Hero />
  <Divider />
  <div class ="flex flex-col gap-6">
  <div class="inline-flex items-baseline">
    <div class="text-xl">{t("recentPosts")}</div>
    <a href={getRelativeLocaleUrl(lang, "/posts")} aria-label={t("readAllPosts")} class="link text-xs ml-auto flex gap-2 text-muted-foreground">
      <span>{t("readMore")}</span>
      <ArrowRightIcon className="w-4 h-4" />
    </a>
  </div>
    <PostsList limit={3}/>
  </div>
</Main>
