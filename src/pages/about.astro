---
import Hero from '@/components/Hero.astro';
import Prose from '@/components/Prose.astro';
import Main from '@/layouts/Main.astro';

const { Content, frontmatter } = await import('@/content/about.md');
---

<Main title={frontmatter.title}>
    <Hero />
    <article class="mt-12">
        <Prose>
            <Content />
        </Prose>
    </article>
</Main>