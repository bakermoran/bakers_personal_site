---
import { getCollection, render } from 'astro:content';
import { getLangFromUrl, formatDate } from '@/i18n/utils';
import Post from '@/layouts/Post.astro';
import Prose from '@/components/Prose.astro';
import Share from '@/components/Share.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.data.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);
---

<Post title={post.data.title}>
    <article class="flex flex-col items-center gap-4">
      <div class="flex flex-col gap-2 w-full max-w-prose">
        <h1 class="text-3xl">{post.data.title}</h1>
        <div class="font-mono">{remarkPluginFrontmatter.minutesRead}</div>
        <time>{formatDate(post.data.date, 'MMMM d, yyyy', getLangFromUrl(Astro.url))}</time>
        <Share />
      </div>
      <Prose>
        <Content />
      </Prose>
    </article>
</Post>