---
import { getCollection, render } from 'astro:content';
import { getLangFromUrl, formatDate, useTranslations } from '@/i18n/utils';
import Post from '@/layouts/Post.astro';
import Prose from '@/components/Prose.astro';
import Share from '@/components/Share.astro';
import Link from '@/components/ui/Link.astro';
import ThemeButton from '@/components/ThemeButton.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.data.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);
const currentLocale = getLangFromUrl(Astro.originPathname);
const t = useTranslations(currentLocale);
---

<Post title={post.data.title}>
    <article class="flex flex-col items-center gap-4">
      <!-- Mobile navigation -->
      <div class="flex flex-col gap-2 w-full max-w-prose">
        <div class="flex gap-4 lg:hidden mb-6">
          <Link href="/" as="button">
            Home
          </Link>
          <ThemeButton />
        </div>

        <h1 class="text-3xl">{post.data.title}</h1>
        <div class="font-mono">{t("minute.read", { minutes: remarkPluginFrontmatter.minutesRead })}</div>
        <time>{formatDate(post.data.date, 'MMMM d, yyyy', getLangFromUrl(Astro.originPathname))}</time>
        <Share />

      </div>
      <Prose>
        <Content />
      </Prose>
    </article>
</Post>