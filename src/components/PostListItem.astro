---
import { format } from 'date-fns';
import type { CollectionEntry } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import SquareIcons from './SquareIcon.astro';
import { ArrowRightIcon } from '@heroicons/react/24/outline'
import { render } from 'astro:content';

interface Props {
  index: number;
  post: CollectionEntry<'blog'>;
}

const { post, index } = Astro.props;
const currentLocale = Astro.currentLocale ?? 'en';

const colors = ['red', 'blue', 'yellow'] as const;
const color = colors[index % colors.length];
const { remarkPluginFrontmatter } = await render(post);
---

<div class="flex flex-col gap-2 py-6">
    <div class="flex items-center gap-4 text-sm text-muted-foreground">
        <SquareIcons color={color} size="small" />
        <h3>{post.data.category}</h3>
        <time>{format(post.data.date, 'MMMM d, yyyy')}</time>
    </div>

    <a
        href={getRelativeLocaleUrl(currentLocale, `/blog/${post.data.id}`)}
        class="text-xl font-bold hover:underline flex items-center justify-between"
    >
        {post.data.title}
        <ArrowRightIcon className="w-5 h-5 ml-2" />
    </a>

    {post.data.tags && (
        <div class="flex gap-2">
            {post.data.tags.map((tag: string) => (
                <span class="text-sm bg-card px-2 py-1 rounded text-card-foreground">{tag}</span>
            ))}
        </div>
    )}

    <div class="text-sm text-muted-foreground">
        {post.data.description}
    </div>

    <div class="text-sm text-muted-foreground">
        {remarkPluginFrontmatter.minutesRead}
    </div>
</div>