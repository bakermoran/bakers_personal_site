---
import Card from '@/components/Card.astro';
interface Props {
  error?: unknown;
  title: string;
  description?: string;
}

const { error, title, description } = Astro.props;
---

<div class="flex flex-col gap-6 mx-auto text-center">
  <h1 class="text-4xl font-mono">{title}</h1>
  {description && <p class="text-sm text-muted-foreground font-mono">{description}</p>}
  {error && (
    <Card>
        <div class="font-mono">{error instanceof Error ? (error as Error).message : "Unknown error"}</div>
    </Card>
  )}
  <slot />
</div>