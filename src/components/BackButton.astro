---
import { ArrowLeftIcon } from '@heroicons/react/24/outline';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const currentLocale = getLangFromUrl(Astro.originPathname);
const t = useTranslations(currentLocale);
---

<a href={`/${currentLocale}/posts`} class="p-2 h-10 rounded-sm hidden lg:block fixed top-4 left-4 text-muted-foreground hover:bg-accent hover:text-foreground transition-all active:scale-95">
    <div class="flex flex-row items-center gap-2">
        <ArrowLeftIcon className="h-4 w-4" />
        {t("nav.back")}
    </div>
</a>
