---
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

interface Props {
  class?: string;
  ariaLabel?: string;
}

const t = useTranslations(getLangFromUrl(Astro.originPathname));

const { class: className, ariaLabel = t("openCommandPalette") } = Astro.props;
---

<button
  type="button"
  data-command-palette-trigger
  class={className}
  aria-label={ariaLabel}
>
  <slot />
</button>

<script>
  import { initCommandPaletteButtons } from "@/scripts/initCommandPaletteButtons";

  initCommandPaletteButtons();
  document.addEventListener("astro:page-load", initCommandPaletteButtons);
</script>
