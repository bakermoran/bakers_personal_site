---
import Button from './Button.astro';
import Link from './Link.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';

const navigation = [
  { name: "Posts", href: "/posts" },
  { name: "About", href: "/about" },
  { name: "Projects", href: "/projects" },
]

const languages = [
  { code: "en", name: "English" },
  { code: "fr", name: "Français" }
]

const currentPath = Astro.url.pathname
const currentLocale = Astro.currentLocale ?? 'en';
const pathWithoutLocale = currentPath.replace(/^\/(en|es|fr)/, '') || '/';

const localizedLinks = languages.map((lang) => ({
  ...lang,
  href: getRelativeLocaleUrl(lang.code, pathWithoutLocale),
}));
---

<header class="sticky top-0 z-50 w-full border-b border-border bg-background/95 backdrop-blur supports-backdrop-filter:bg-background/60">
  <div class="mx-auto flex h-16 max-w-4xl items-center justify-between px-6">

    <!-- Logo / Name -->
    <Link href="/">
      <div class="flex items-center gap-0.5">
        <div class="h-4 w-4 bg-mcm-red"></div>
        <div class="h-4 w-4 bg-mcm-blue"></div>
        <div class="h-4 w-4 bg-mcm-yellow"></div>
      </div>
      <span class="text-lg font-medium tracking-tight text-foreground">Baker Moran</span>
    </Link>

    <!-- Desktop Navigation -->
    <nav class="hidden items-center gap-8 md:flex" aria-label="Main navigation">
      {navigation.map((item) => (
        <Link
          href={item.href}
        >
          {item.name}
        </Link>
      ))}
    </nav>

    <!-- Right side controls -->
    <div class="flex items-center gap-2">

      <!-- Language Dropdown -->
      <details class="dropdown relative">
        <summary class="flex cursor-pointer list-none items-center gap-1.5 rounded-md px-2 py-1.5 text-sm text-muted-foreground transition-colors hover:bg-accent hover:text-foreground">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/>
          </svg>
          <span class="hidden text-sm sm:inline">{currentLocale.toUpperCase()}</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m6 9 6 6 6-6"/>
          </svg>
        </summary>
        <ul class="dropdown-menu absolute right-0 top-full z-50 mt-1 w-36 rounded-md border border-border bg-background py-1 shadow-md">
          {localizedLinks.map((lang) => (
            <li>
              <a
                href={lang.href}
                class="block px-3 py-1.5 text-sm text-foreground transition-colors hover:bg-accent"
                aria-current={lang.code === currentLocale ? "true" : undefined}
              >
                {lang.name}
              </a>
            </li>
          ))}
        </ul>
      </details>

      <!-- Theme Toggle -->
      <Button
        id="theme-toggle"
        aria-label="Toggle theme"
      >
        <!-- Sun -->
        <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 rotate-0 scale-100 transition-all dark:-rotate-90 dark:scale-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
        </svg>
        <!-- Moon -->
        <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" class="absolute inset-2 h-4 w-4 rotate-90 scale-0 transition-all dark:rotate-0 dark:scale-100" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
        </svg>
      </Button>

      <!-- Mobile Navigation Dropdown -->
      <details class="dropdown relative md:hidden">
        <summary class="flex cursor-pointer list-none items-center rounded-md px-3 py-1.5 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-foreground">
          Menu
        </summary>
        <ul class="dropdown-menu absolute right-0 top-full z-50 mt-1 w-36 rounded-md border border-border bg-background py-1 shadow-md">
          {navigation.map((item) => (
            <li>
                <a
                  href={getRelativeLocaleUrl(currentLocale, item.href)}
                  aria-current={currentPath.startsWith(item.href) ? "page" : undefined}
                  class="block px-3 py-1.5 text-sm text-foreground transition-colors hover:bg-accent aria-[current=page]:font-medium"
                >
                  {item.name}
                </a>
            </li>
          ))}
        </ul>
      </details>

    </div>
  </div>
</header>
