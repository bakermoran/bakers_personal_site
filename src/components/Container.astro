---
import { twMerge } from 'tailwind-merge';

interface Props {
    size?: 'small' | 'medium' | 'large';
    class?: string;
}

const { size = 'medium', class: className } = Astro.props;

const sizeClasses = {
    small: 'max-w-xl',
    medium: 'max-w-3xl',
    large: 'max-w-4xl',
};
---

<div class={twMerge(`mx-auto px-6 ${sizeClasses[size]}`, className)}>
    <slot />
</div>