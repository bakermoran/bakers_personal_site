---
import Logo from "./Logo.astro"
import PageLinks from "./PageLinks.astro"
---

<footer class="flex px-6 mt-8 flex-row items-center text-sm justify-between h-16 w-full border-t border-border bg-background">
    <div class="flex gap-2 items-center">
        <Logo size="small"/>
        <span>&copy; {new Date().getFullYear()} Baker Moran</span>
    </div>

    <div class="flex gap-4 items-center">
        <PageLinks class:list="gap-4" />
        <a href="rss.xml">RSS</a>
    </div>
</footer>