---
import Button from '@/components/ui/Button.astro';
import { SunIcon, MoonIcon } from '@heroicons/react/24/outline';

interface Props {
  class?: string;
}
---

<Button
  id="theme-toggle"
  aria-label="Toggle theme"
  class={`relative inline-flex h-10 w-10 items-center justify-center ${Astro.props.class ?? ''}`}
>
  <span class="relative block h-5 w-5">
    <SunIcon
      className="absolute inset-0 h-5 w-5 rotate-0 scale-100 transition-all dark:-rotate-90 dark:scale-0"
    />
    <MoonIcon
      className="absolute inset-0 h-5 w-5 rotate-90 scale-0 transition-all dark:rotate-0 dark:scale-100"
    />
  </span>
</Button>

<script>
  import { setTheme } from "@/scripts/setTheme";

  function initThemeToggle() {
    const btn = document.getElementById('theme-toggle');
    if (!btn || btn.dataset.themeBound === 'true') return;

    btn.dataset.themeBound = 'true';
    btn.addEventListener('click', () => {
      const nextTheme = document.documentElement.classList.contains('dark') ? 'light' : 'dark';
      localStorage.setItem('theme', nextTheme);
      setTheme();
    });
  }

  initThemeToggle();
  document.addEventListener('astro:page-load', initThemeToggle);
</script>
