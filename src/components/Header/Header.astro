---
import ThemeButton from './ThemeButton.astro';
import Link from '@/components/ui/Link.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import LocaleSwitcher from '@/components/islands/LocaleSwitcher';
import Logo from '../Logo.astro';
import PageLinks from '../PageLinks.astro';
import MobileNav from '@/components/islands/MobileNav';

const languages = [
  { code: "en", name: "English" },
  { code: "fr", name: "Français" }
]

const currentPath = Astro.url.pathname
const currentLocale = Astro.currentLocale ?? 'en';
const pathWithoutLocale = currentPath.replace(/^\/(en|fr)/, '') || '/';

const localizedLinks = languages.map((lang) => ({
  ...lang,
  href: getRelativeLocaleUrl(lang.code, pathWithoutLocale),
}));
---

<header id='site-header' class="sticky top-0 z-50 w-full border-b border-border bg-background/95 backdrop-blur supports-backdrop-filter:bg-background/60 transition-transform duration-300">
  <div class="mx-auto flex h-16 items-center justify-between px-6">

    <!-- Logo / Name -->
    <Link href="/">
      <Logo />
      <span class="text-lg font-medium tracking-tight text-foreground">Baker Moran</span>
    </Link>

    <!-- Desktop Navigation -->
    <PageLinks class:list="gap-8" />

    <!-- Right side controls -->
    <div class="flex items-center gap-2">

      <LocaleSwitcher
        client:load
        currentLocale={currentLocale}
        localizedLinks={localizedLinks}
      />
      <ThemeButton />

      <!-- Mobile Navigation Dropdown -->
      <MobileNav client:load currentPath={currentPath} />
    </div>
  </div>
</header>

<script is:inline>
  const header = document.getElementById('site-header');

  let lastY = window.scrollY;
  let ticking = false;

  const updateHeader = () => {
    const currentY = window.scrollY;
    const scrollingDown = currentY > lastY;
    const scrollingUp = currentY < lastY;

    if (currentY <= 8) {
      header?.classList.remove('-translate-y-full');
      lastY = currentY;
      ticking = false;
      return;
    }

    if (scrollingDown && currentY > 80) {
      header?.classList.add('-translate-y-full');
    } else if (scrollingUp) {
      header?.classList.remove('-translate-y-full');
    }

    lastY = currentY;
    ticking = false;
  };

  const onScroll = () => {
    if (!ticking) {
      window.requestAnimationFrame(updateHeader);
      ticking = true;
    }
  };

  window.addEventListener('scroll', onScroll, { passive: true });
</script>