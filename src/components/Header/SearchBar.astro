---
import Input from "@/components/ui/Input.astro";
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const currentLocale = getLangFromUrl(Astro.originPathname);
const t = useTranslations(currentLocale);
---

<button
  type="button"
  id="command-palette-trigger"
  class="hidden lg:block text-left rounded-md border border-muted active:scale-98"
  aria-label="Open command palette"
>
  <Input
    type="text"
    placeholder={`⌘ K ${t("search")}...`}
    readonly
    tabindex="-1"
    class="pointer-events-none bg-popover px-3 py-2"
  />
</button>

<script>
  import { openCommandPalette } from "@/scripts/openCommandPalette";

  function initSearchBar() {
    const btn = document.getElementById("command-palette-trigger");
    if (!btn || btn.dataset.searchBound === "true") return;

    btn.dataset.searchBound = "true";
    const input = btn.querySelector("input");
    if (input && !navigator.platform.toLowerCase().includes("mac")) {
      input.placeholder = "Ctrl K Search...";
    }
    btn.addEventListener("click", () => {
      openCommandPalette();
    });
  }

  initSearchBar();
  document.addEventListener("astro:page-load", initSearchBar);
</script>
