---
import { icon } from "@fortawesome/fontawesome-svg-core";
import { faGithub, faLinkedin } from "@fortawesome/free-brands-svg-icons";
import { faEnvelope } from "@fortawesome/free-solid-svg-icons";

const links = [
    {
        name: 'GitHub',
        url: 'https://github.com/bakermoran',
        svg: icon(faGithub).html[0]
    },
    {
        name: 'LinkedIn',
        url: 'https://www.linkedin.com/in/baker-moran-a47b17114/',
        svg: icon(faLinkedin).html[0]
    },
    {
        name: 'Email',
        url: 'mailto:bamoran99@gmail.com',
        svg: icon(faEnvelope).html[0]
    }
];
---

<div class="flex items-center gap-4">
    {links.map(({ url, svg, name }) => (
        <a
            href={url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={name}
            class="text-muted-foreground active:scale-95 hover:text-primary transition-all duration-200 [&>svg]:h-6 [&>svg]:w-6"
        >
            <Fragment set:html={svg} />
        </a>
    ))}
</div>
