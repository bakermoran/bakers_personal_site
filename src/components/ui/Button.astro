---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<"button"> {
  variant?: 'primary' | 'secondary';
  size?: 'sm' | 'md' | 'lg';
}

const { variant = 'primary', size = 'md', ...attrs } = Astro.props;

const styles = {
  button: "relative rounded-md p-2 transition-colors rounded-sm",
  variants: {
    primary: "text-muted-foreground hover:bg-accent hover:text-foreground",
    secondary: "text-foreground hover:bg-secondary hover:text-foreground",
  },
  sizes: {
    sm: "px-3 py-1.5 text-sm",
    md: "px-4 py-2 text-base",
    lg: "px-6 py-3 text-lg",
  },
};

const className = `${styles.button} ${styles.variants[variant]} ${styles.sizes[size]}`;
---

<button
    class={className}
    {...attrs}
>
  <slot />
</button>
