---
import { Image } from 'astro:assets';
import profilePic from '../content/images/profile.png';
import SocialLinks from './SocialLinks.astro';

---

<div class="flex items-center gap-8">
    <Image
        src={profilePic}
        alt="Profile"
        priority={true}
        width={200}
        height={200}
        class="rounded-lg"
    />
    <div class="flex flex-col gap-4">
        <div>
            <a class="text-4xl font-bold mb-2" href="/about">Hi, I'm Baker!</a>
            <p class="text-lg text-muted-foreground">Welcome to my personal blog where I share my thoughts on technology, programming, and more.</p>
        </div>
        <SocialLinks />
    </div>
</div>