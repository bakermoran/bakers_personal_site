---
import Header from '@/components/Header/Header.astro';
import Container from '@/components/Container.astro';
import Layout from './Layout.astro';

interface Props {
  title: string;
  class?: string;
}

const { title, class: className } = Astro.props;
---
<Layout title={title}>
  <Header />
  <Container class={className}>
    <slot />
  </Container>
</Layout>