---
import Header from '@/components/Header/Header.astro';
import Container, { type Props as ContainerProps } from '@/components/Container.astro';
import Layout from './Layout.astro';

interface Props extends ContainerProps {
  title: string;
}

const { title, size, class: className } = Astro.props;
---
<Layout title={title}>
  <Header />
  <Container size={size} class={className}>
    <slot />
  </Container>
</Layout>